+// flushTXBuffer() are reachable from cdc0_write_char() in ISR context.
+static inline void hw_cdc_clear_tx_stash(void) {
+  portENTER_CRITICAL_SAFE(&hw_cdc_tx_mux);
+  tx_stash_len = 0;
+  portEXIT_CRITICAL_SAFE(&hw_cdc_tx_mux);
+}
 
