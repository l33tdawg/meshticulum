 void ArduinoHal::spiTransfer(uint8_t* out, size_t len, uint8_t* in) {
+#if MTBENCH_ESP32_BULK_SPI
+  // Preserve the old byte-wise semantics for partially overlapping buffers:
+  // an earlier output byte may become a later input byte. Exact alias is safe.
+  const uintptr_t source = reinterpret_cast<uintptr_t>(out);
+  const uintptr_t destination = reinterpret_cast<uintptr_t>(in);
+  const bool partialOverlap = (source < destination && destination - source < len)
+                           || (destination < source && source - destination < len);
+  if(!partialOverlap) {
+    // ESP32 transferBytes reads rounded-up input words. Aligned, padded
+    // scratch avoids unaligned access and caller tail overread. Never widen
+    // the wire length. Module still owns the original CS/transaction and
+    // all command status, BUSY, RX priority and authority checks.
+    alignas(uint32_t) uint8_t tx[64];
+    alignas(uint32_t) uint8_t rx[64];
+    while(len) {
+      const size_t count = len < sizeof(tx) ? len : sizeof(tx);
+      std::memset(tx, 0, sizeof(tx));
+      std::memcpy(tx, out, count);
+      spi->transferBytes(tx, rx, static_cast<uint32_t>(count));
+      std::memcpy(in, rx, count);
+      out += count;
+      in += count;
+      len -= count;
+    }
+    return;
+  }
+#endif
   for(size_t i = 0; i < len; i++) {
     in[i] = spi->transfer(out[i]);
   }
